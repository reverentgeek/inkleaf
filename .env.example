# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inkleaf?retryWrites=true&w=majority

# Database name (optional, default inkleaf)
# MONGODB_DB=inkleaf

# Embedding provider for Vector Search: "voyage" (default, MongoDB Voyage AI) or "openai"
# EMBEDDING_PROVIDER=voyage

# API key for the chosen provider (required for Vector Search / embeddings).
# Use VOYAGE_API_KEY when EMBEDDING_PROVIDER=voyage, OPENAI_API_KEY when =openai.
VOYAGE_API_KEY=...
# OPENAI_API_KEY=sk-...

# Override the embedding model (optional).
# Defaults: voyage-4-lite (voyage), text-embedding-3-small (openai)
# EMBEDDING_MODEL=

# Override vector dimensions (optional). Must match the model AND the Atlas vector index.
# Defaults: 1536 (openai), 1024 (voyage)
# EMBEDDING_DIMENSIONS=

# Backend port (optional, default 3001)
PORT=3001

# Local SQLite store for offline support (optional, default backend/data/inkleaf.db)
# SQLITE_PATH=/path/to/inkleaf.db

# Background sync interval in ms (optional, default 15000)
# SYNC_INTERVAL_MS=15000
